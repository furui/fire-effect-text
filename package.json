{
  "name": "fire-effect-text",
  "version": "1.0.0",
  "description": "Burning text effect for React and plain JavaScript.",
  "type": "module",
  "author": "Jeff Davis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/furui/fire-effect-text.git"
  },
  "bugs": {
    "url": "https://github.com/furui/fire-effect-text/issues"
  },
  "homepage": "https://github.com/furui/fire-effect-text#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/fire-text.global.js",
  "jsdelivr": "./dist/fire-text.global.js",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./vanilla": {
      "types": "./types/vanilla.d.ts",
      "import": "./dist/vanilla.mjs",
      "require": "./dist/vanilla.cjs",
      "default": "./dist/vanilla.mjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs",
      "default": "./dist/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "docs/preview.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "node scripts/build-lib.mjs",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "node --test test/fire-text.test.mjs",
    "test:dist": "node --test test/dist.test.mjs",
    "test:browser": "node --test test/browser.test.mjs",
    "typecheck": "tsc -p tsconfig.types.json",
    "screenshot": "npm run build:demo && node scripts/capture-preview.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build && npm run test:dist",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "keywords": [
    "fire",
    "fire-text",
    "burning-text",
    "flame",
    "canvas",
    "fluid-simulation",
    "navier-stokes",
    "blackbody",
    "react",
    "react-component",
    "vanilla-js",
    "webgl",
    "webgl2",
    "webgpu",
    "webgpu-compute",
    "typography"
  ]
}
